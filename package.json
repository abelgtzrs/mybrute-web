{
  "name": "mybrute-plus",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @mybrute/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run build && npm run start -w @mybrute/server"
  },
  "engines": {
    "node": ">=20"
  }
}
